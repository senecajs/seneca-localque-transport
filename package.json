{
  "name": "@seneca/localque-transport",
  "version": "0.3.0",
  "main": "dist/LocalqueTransport.js",
  "type": "commonjs",
  "types": "dist/LocalqueTransport.d.ts",
  "description": "Local in-process que transport for Seneca messages. Use for local dev and testing.",
  "homepage": "https://github.com/senecajs/seneca-localque-transport",
  "keywords": [
    "seneca",
    "transport",
    "localque",
    "localque-transport"
  ],
  "author": "Richard Rodger - richardrodger.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-localque-transport.git"
  },
  "scripts": {
    "prettier": "prettier --write .",
    "test": "jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "doc": "seneca-doc",
    "clean": "rm -rf node_modules yarn.lock package-lock.json dist",
    "reset": "npm run clean && npm i && npm run build && npm test && npm run doc"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "CHANGES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@seneca/doc": "^9.0.0",
    "@seneca/entity": "^29.0.0",
    "@seneca/transport": "^9.0.0",
    "@types/async": "^3.2.24",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.21.5",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.7.0",
    "prettier": "3.3.1",
    "seneca": "^4.0.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "seneca": "^4.0.0",
    "@seneca/entity": "^29.0.0"
  },
  "peerDependenciesMeta": {
    "@seneca/entity": {
      "optional": true
    }
  },
  "dependencies": {
    "async": "^3.2.5"
  }
}
